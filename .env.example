# Kopie pro lokální vývoj: cp .env.example .env.local
# Skutečné hodnoty NIKDY necommituj — .env.local je v .gitignore.
#
# Všechny proměnné níže jsou volitelné. /stream funguje i bez nich —
# provider bez konfigurace se jen graceful přeskočí (viz lib/streams/*).

# Twitch Helix API — app token (client credentials, bez loginu uživatele).
# Získání: vytvoř aplikaci na https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3.
# Získání: Google Cloud Console (console.cloud.google.com) — vytvoř
# projekt, zapni "YouTube Data API v3", vygeneruj API klíč.
YOUTUBE_API_KEY=

# Kick Public API — app token (client credentials, bez loginu uživatele).
# Získání: vytvoř aplikaci na https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- Steam přihlášení (lib/auth/*, app/api/auth/*) ---
# Bez těchto proměnných build i web fungují dál, jen je přihlášení
# přes Steam vypnuté (CTA vrátí 503 s hláškou, viz login route).

# Steam Web API klíč — pro GetPlayerSummaries (nickname/avatar po
# přihlášení). Získání: https://steamcommunity.com/dev/apikey
# (přihlásit se Steam účtem, jako "Domain Name" zadat production
# doménu webu, např. howtofish.cz).
STEAM_API_KEY=

# Dlouhý náhodný řetězec pro podepisování session cookie (HMAC).
# Vygeneruj např.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Nikdy nesdílej, nikdy necommituj.
SESSION_SECRET=

# Absolutní URL webu — používá se pro Steam OpenID realm/return_to.
# V produkci nastav vždy explicitně (např. https://howtofish.cz).
# Lokálně lze nechat prázdné — spadne to na http://localhost:3000.
SITE_URL=

# Připojení k Postgres (Neon) — v Vercelu doplní automaticky napojená
# Neon integrace (DATABASE_URL a spol.), lokálně stáhni přes
# `vercel env pull .env.local`. Sem se nic ručně nepíše.
